<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_blue_gradient">

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reminder"
            android:textStyle="bold"
            android:textColor="#1F3763"
            android:textSize="20sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"/>

        <!-- MONTH NAVIGATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/btnPrevMonth"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_arrow_back"
                android:background="@android:color/transparent"
                android:tint="#1F3763"/>

            <TextView
                android:id="@+id/tvMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mei 2026"
                android:textColor="#1F3763"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <ImageButton
                android:id="@+id/btnNextMonth"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_arrow_right"
                android:background="@android:color/transparent"
                android:tint="#1F3763"/>
        </LinearLayout>

        <!-- CALENDAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_calendar"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- DAY HEADERS -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="7">
                <TextView android:text="Sen" style="@style/calendarHeader"/>
                <TextView android:text="Sel" style="@style/calendarHeader"/>
                <TextView android:text="Rab" style="@style/calendarHeader"/>
                <TextView android:text="Kam" style="@style/calendarHeader"/>
                <TextView android:text="Jum" style="@style/calendarHeader"/>
                <TextView android:text="Sab" style="@style/calendarHeader"/>
                <TextView android:text="Min" style="@style/calendarHeader"/>
            </GridLayout>

            <!-- DYNAMIC CALENDAR GRID -->
            <GridLayout
                android:id="@+id/calendarGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="7"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- SELECTED DATE LABEL -->
        <TextView
            android:id="@+id/tvSelectedDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tugas hari ini"
            android:textColor="#B6B6B6"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp"
            android:layout_marginStart="4dp"/>

        <!-- LIST TUGAS -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReminderTeacher"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp"/>

    </LinearLayout>

    <!-- BOTTOM NAV -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_nav_teacher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>