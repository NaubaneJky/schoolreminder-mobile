<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_profile_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- BARIS 1: JUDUL + STATUS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Judul Tugas"
            android:textStyle="bold"
            android:textColor="#1D2B53"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aktif"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_circle_blue"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"/>
    </LinearLayout>

    <!-- DEADLINE -->
    <TextView
        android:id="@+id/tvDeadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Deadline"
        android:textSize="12sp"
        android:textColor="#8A8A8A"
        android:layout_marginTop="4dp"/>

    <!-- SUBMISSION -->
    <TextView
        android:id="@+id/tvSubmission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 dari 0 siswa sudah mengumpulkan"
        android:textSize="12sp"
        android:textColor="#5FADEB"
        android:layout_marginTop="4dp"/>

    <!-- PROGRESS BAR -->
    <ProgressBar
        android:id="@+id/progressTask"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:progressTint="#5FADEB"
        android:progressBackgroundTint="#E0E0E0"
        android:max="100"
        android:progress="50"/>

</LinearLayout>